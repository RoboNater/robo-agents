{
  "mcpServers": {
    "hub": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/agent-hub",
        "worker-mcp"
      ],
      "env": {
        "HUB_URL": "http://alice-host:8420",
        "HUB_TOKEN": "...",
        "AGENT_NAME": "bob",
        "AGENT_RUNTIME": "claude-code"
      }
    }
  }
}
