# Bind address. Binding a wildcard (0.0.0.0, ::) requires HUB_PUBLIC_URL below,
# since workers cannot dial a bind address.
HUB_HOST=127.0.0.1
HUB_PORT=8420

# Address advertised in the agent card. Defaults to http://HUB_HOST:HUB_PORT,
# which is only correct for a loopback bind. Set it to the address remote
# workers use, e.g. http://alice-host:8420.
HUB_PUBLIC_URL=http://127.0.0.1:8420

# Runtime state. HUB_STATE_DIR defaults to $XDG_STATE_HOME/agent-hub (or
# ~/.local/state/agent-hub), so the hub finds its previous state regardless of
# the working directory the MCP client happens to start it in. HUB_DB_PATH and
# HUB_TOKEN_FILE are resolved from HUB_STATE_DIR when relative.
# HUB_STATE_DIR=~/.local/state/agent-hub
HUB_DB_PATH=hub.db
HUB_TOKEN_FILE=token

# Existing HUB_TOKEN_FILE files must be owner-only (mode 0600). For mounted or
# runtime-injected secrets, set HUB_TOKEN instead to bypass the file check.
# HUB_TOKEN=replace-with-a-long-random-value
