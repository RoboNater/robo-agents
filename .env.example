# Bind and advertise settings. HUB_PUBLIC_URL is useful when workers are remote.
HUB_HOST=127.0.0.1
HUB_PORT=8420
HUB_PUBLIC_URL=http://127.0.0.1:8420

# Runtime state. Relative paths are resolved from the process working directory.
HUB_DB_PATH=.hub/hub.db
HUB_TOKEN_FILE=.hub/token

# Set this instead of HUB_TOKEN_FILE when the secret is injected by the runtime.
# HUB_TOKEN=replace-with-a-long-random-value
